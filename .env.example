# local (default) | supabase
VITE_STORAGE_DRIVER=local

# Required when VITE_STORAGE_DRIVER=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Web Push (optional; needed for weekly reminders)
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# Optional absolute student PWA URL (defaults to BASE_URL + student/)
# VITE_STUDENT_APP_URL=https://wongcsomyfriend-svg.github.io/homework-tracker/student/
